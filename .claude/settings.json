    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bin/alpaca-python -m alpaca.hooks.session_end",
            "timeout": 60
          }
        ]
